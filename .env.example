DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require

# --- Member 4: GenAI layer ---
# OpenRouter access for the chat models (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
MAX_TOOL_CALL_ROUNDS=5

# MCP servers (registered by Members 2/3; leave empty until deployed)
MCP_OWNER_SERVER_URL=
MCP_DRIVER_SERVER_URL=

# Embeddings run locally via sentence-transformers (no API key needed).
# Keep RAG_EMBEDDING_DIMENSIONS in sync with the chosen model's native
# dimension: all-MiniLM-L6-v2=384, all-mpnet-base-v2=768, BAAI/bge-large-en-v1.5=1024.
RAG_SENTENCE_TRANSFORMERS_MODEL=all-MiniLM-L6-v2
RAG_EMBEDDING_DIMENSIONS=384
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=4
RAG_MIN_SCORE=0.35
